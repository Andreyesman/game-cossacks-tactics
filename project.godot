; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[animation]

compatibility/default_parent_skeleton_in_mesh_instance_3d=true

[application]

config/name="Goddot (CossacksTactics2)"
run/main_scene="res://src/scenes/MainMenu.tscn"
config/features=PackedStringArray("4.6", "Forward Plus")
config/icon="res://assets/icon.svg"

[autoload]

Globals="*res://src/core/Globals.gd"
FloatingLabel="*res://src/ui/FloatingLabel.tscn"
SaveManager="*res://src/core/SaveManager.gd"
CampaignManager="*res://src/core/CampaignManager.gd"
LocaleManager="*res://src/core/LocaleManager.gd"
AudioManager="*res://src/core/AudioManager.gd"
_mcp_game_helper="*res://addons/godot_ai/runtime/game_helper.gd"

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[editor_plugins]

enabled=PackedStringArray("res://addons/godot_ai/plugin.cfg")

[gui]

theme/custom="res://assets/theme/game_theme.tres"
theme/default_font="res://assets/fonts/NyghtSerif-Bold.ttf"
theme/default_font_size=16

[internationalization]

locale/translations=PackedStringArray("res://localization/translations.uk.translation", "res://localization/translations.en.translation")

[rendering]

environment/defaults/default_clear_color=Color(0.031, 0.027, 0.027, 1)
